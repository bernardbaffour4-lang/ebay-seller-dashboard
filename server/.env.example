# eBay Developer App credentials
# Get these from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here

# Must match the RuName configured in your eBay developer app
EBAY_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Use 'sandbox' for testing, 'production' for live data
EBAY_ENVIRONMENT=production

# eBay Marketplace ID (EBAY_US, EBAY_GB, EBAY_DE, etc.)
EBAY_MARKETPLACE_ID=EBAY_US

PORT=3001
